#include "mcc_generated_files/system/system.h"

/*
    Main application
*/

#include <stdint.h>

#define LORA_REG_FIFO                 0x00U
#define LORA_REG_OP_MODE              0x01U
#define LORA_REG_FRF_MSB              0x06U
#define LORA_REG_FRF_MID              0x07U
#define LORA_REG_FRF_LSB              0x08U
#define LORA_REG_PA_CONFIG            0x09U
#define LORA_REG_FIFO_ADDR_PTR        0x0DU
#define LORA_REG_FIFO_TX_BASE_ADDR    0x0EU
#define LORA_REG_FIFO_RX_BASE_ADDR    0x0FU
#define LORA_REG_FIFO_RX_CURRENT_ADDR 0x10U
#define LORA_REG_IRQ_FLAGS            0x12U
#define LORA_REG_RX_NB_BYTES          0x13U
#define LORA_REG_MODEM_CONFIG_1       0x1DU
#define LORA_REG_MODEM_CONFIG_2       0x1EU
#define LORA_REG_MODEM_CONFIG_3       0x26U
#define LORA_REG_PAYLOAD_LENGTH       0x22U
#define LORA_REG_VERSION              0x42U

#define LORA_LONG_RANGE_MODE          0x80U
#define LORA_MODE_SLEEP                0x00U
#define LORA_MODE_STDBY                0x01U
#define LORA_MODE_TX                   0x03U
#define LORA_MODE_RX_CONTINUOUS        0x05U
#define LORA_IRQ_RX_DONE               0x40U
#define LORA_IRQ_PAYLOAD_CRC_ERROR     0x20U
#define LORA_IRQ_VALID_HEADER          0x10U
#define LORA_IRQ_TX_DONE               0x08U

#define LORA_PACKET_MAGIC              0xA5U
#define COMMAND_LED_1                  0x01U
#define COMMAND_LED_2                  0x02U

/*
 * Board connections:
 *   RC4, RC5 -> buttons (active high); RC4 is command 1, RC5 is command 2
 *   RC3      -> power indicator LED, lit for as long as the board is supplied
 *   RC6      -> second LED, used only to report a LoRa detection failure
 *   RC1      -> TPL5110 DONE (active high; stops the timer and removes power)
 *
 * Power-cycle test: RC3 lights up as soon as the firmware starts. A press on
 * either button transmits the command and then drives RC1 low -> high, so the
 * TPL5110 cuts the supply and RC3 visibly goes dark. When the timer restores
 * power the firmware restarts and RC3 lights up again.
 */
#define TPL5110_DONE_ASSERT_DELAY_MS   1U
#define TPL5110_MDRV_SETTLE_MS         60U
#define TPL5110_DONE_PULSES            10U
#define BUTTON_DEBOUNCE_MS             20U

/* Visible in the MPLAB Watch window and encoded on LEDs if SPI detection fails. */
static volatile uint8_t loraVersion = 0xFFU;

static void LoRa_Select(void)
{
    LATBbits.LATB5 = 0;
}

static void LoRa_Deselect(void)
{
    LATBbits.LATB5 = 1;
}

static void LoRa_WriteRegister(uint8_t address, uint8_t value)
{
    LoRa_Select();
    (void)Lora_SPI.ByteExchange(address | 0x80U);
    (void)Lora_SPI.ByteExchange(value);
    LoRa_Deselect();
}

static uint8_t LoRa_ReadRegister(uint8_t address)
{
    uint8_t value;

    LoRa_Select();
    (void)Lora_SPI.ByteExchange(address & 0x7FU);
    value = Lora_SPI.ByteExchange(0x00U);
    LoRa_Deselect();

    return value;
}

static uint8_t LoRa_Initialize(void)
{
    /* Allow the RF96 crystal and power-on reset to settle. */
    __delay_ms(10);

    if (!Lora_SPI.Open(0U))
    {
        return 0U;
    }

    /* SX1276/RFM96 uses SPI mode 0: clock idle low, data sampled on rising edge. */
    SSP1CON1bits.CKP = 0;
    SSP1STATbits.CKE = 1;

    /* The RF96/RFM96W uses an SX1276. RegVersion must be 0x12. */
    loraVersion = LoRa_ReadRegister(LORA_REG_VERSION);
    if (loraVersion != 0x12U)
    {
        return 0U;
    }

    LoRa_WriteRegister(LORA_REG_OP_MODE, LORA_LONG_RANGE_MODE | LORA_MODE_SLEEP);
    LoRa_WriteRegister(LORA_REG_FRF_MSB, 0xD9U); /* 868.000 MHz */
    LoRa_WriteRegister(LORA_REG_FRF_MID, 0x00U);
    LoRa_WriteRegister(LORA_REG_FRF_LSB, 0x00U);
    LoRa_WriteRegister(LORA_REG_PA_CONFIG, 0x8FU); /* PA_BOOST, about 14 dBm */
    LoRa_WriteRegister(LORA_REG_MODEM_CONFIG_1, 0x72U); /* BW 125 kHz, CR 4/5 */
    LoRa_WriteRegister(LORA_REG_MODEM_CONFIG_2, 0x74U); /* SF7, CRC enabled */
    LoRa_WriteRegister(LORA_REG_MODEM_CONFIG_3, 0x04U); /* Automatic gain control */
    LoRa_WriteRegister(LORA_REG_FIFO_TX_BASE_ADDR, 0x00U);
    LoRa_WriteRegister(LORA_REG_FIFO_RX_BASE_ADDR, 0x00U);
    LoRa_WriteRegister(LORA_REG_IRQ_FLAGS, 0xFFU);
    LoRa_WriteRegister(LORA_REG_OP_MODE, LORA_LONG_RANGE_MODE | LORA_MODE_STDBY);

    return 1U;
}

static uint8_t LoRa_Send(uint8_t message)
{
    uint8_t timeout;

    LoRa_WriteRegister(LORA_REG_OP_MODE, LORA_LONG_RANGE_MODE | LORA_MODE_STDBY);
    LoRa_WriteRegister(LORA_REG_FIFO_ADDR_PTR, 0x00U);
    LoRa_WriteRegister(LORA_REG_FIFO, LORA_PACKET_MAGIC);
    LoRa_WriteRegister(LORA_REG_FIFO, message);
    LoRa_WriteRegister(LORA_REG_FIFO, (uint8_t)(message ^ 0x5AU));
    LoRa_WriteRegister(LORA_REG_PAYLOAD_LENGTH, 3U);
    LoRa_WriteRegister(LORA_REG_IRQ_FLAGS, 0xFFU);
    LoRa_WriteRegister(LORA_REG_OP_MODE, LORA_LONG_RANGE_MODE | LORA_MODE_TX);

    for (timeout = 0U; timeout < 200U; timeout++)
    {
        if ((LoRa_ReadRegister(LORA_REG_IRQ_FLAGS) & LORA_IRQ_TX_DONE) != 0U)
        {
            LoRa_WriteRegister(LORA_REG_IRQ_FLAGS, LORA_IRQ_TX_DONE);
            return 1U;
        }
        __delay_ms(1);
    }

    LoRa_WriteRegister(LORA_REG_OP_MODE, LORA_LONG_RANGE_MODE | LORA_MODE_STDBY);
    return 0U;
}

static void LoRa_ShowNibble(uint8_t value)
{
    uint8_t count;

    if (value == 0U)
    {
        /* A long ON pulse represents hex digit 0. */
        IO_RC6_SetHigh();
        __delay_ms(600);
        IO_RC6_SetLow();
        __delay_ms(300);
        return;
    }

    for (count = 0U; count < value; count++)
    {
        IO_RC6_SetHigh();
        __delay_ms(120);
        IO_RC6_SetLow();
        __delay_ms(120);
    }
    __delay_ms(500);
}

/*
 * Blinks RegVersion on RC6, high hex digit first. RC3 is deliberately left
 * alone so that the power indicator stays readable during the test.
 */
static void LoRa_ShowVersionError(void)
{
    LoRa_ShowNibble((loraVersion >> 4) & 0x0FU);
    LoRa_ShowNibble(loraVersion & 0x0FU);
    __delay_ms(800);
}

/*
 * Returns the pressed buttons as a COMMAND_LED_x bitmap, or 0 when none is
 * held. The hardware buttons are active high; PORTC has no weak pull-ups on
 * this device, so the pull-downs are external.
 */
static uint8_t Buttons_Read(void)
{
    uint8_t buttons = 0U;

    if (IO_RC4_GetValue() != 0U)
    {
        buttons |= COMMAND_LED_1;
    }
    if (IO_RC5_GetValue() != 0U)
    {
        buttons |= COMMAND_LED_2;
    }

    return buttons;
}

static uint8_t Buttons_ReadDebounced(void)
{
    uint8_t buttons = Buttons_Read();

    if (buttons == 0U)
    {
        return 0U;
    }

    __delay_ms(BUTTON_DEBOUNCE_MS);

    /* A mismatch means bounce, or a second button still on its way down. */
    return (Buttons_Read() == buttons) ? buttons : 0U;
}

static void TPL5110_RequestPowerOff(void)
{
    uint8_t pulse;

    /*
     * Wait for the buttons to come back up before signalling DONE. If a button
     * also feeds the TPL5110 DELAY/M_DRV pin, the datasheet is explicit in
     * section 8.5.2: "DONE signals received while the DELAY/M_DRV is HIGH are
     * ignored". M_DRV carries a 20 ms de-bounce on both edges, hence the
     * settling delay after the release.
     */
    while (Buttons_Read() != 0U)
    {
        /* Finger still down. */
    }
    __delay_ms(TPL5110_MDRV_SETTLE_MS);

    /*
     * DONE is edge triggered, minimum width 100 ns, and only the first edge in
     * an interval is processed. Pulsing beats latching the level high: a
     * static level gives exactly one chance, and an ignored edge can never be
     * retried. No SPI access is allowed ahead of this loop either, since
     * SPI1_ByteExchange would spin forever with the MSSP disabled.
     */
    for (pulse = 0U; pulse < TPL5110_DONE_PULSES; pulse++)
    {
        LATCbits.LATC1 = 1;
        __delay_ms(TPL5110_DONE_ASSERT_DELAY_MS);
        LATCbits.LATC1 = 0;
        __delay_ms(TPL5110_DONE_ASSERT_DELAY_MS);
    }

    LATCbits.LATC1 = 1;

    /*
     * Only reached when the supply survived every DONE edge. Blinking RC3 says
     * "the firmware got here and RC1 is high", which separates a firmware
     * problem from a wiring problem: steady RC3 means execution never arrived.
     */
    while (1)
    {
        IO_RC3_SetLow();
        __delay_ms(100);
        IO_RC3_SetHigh();
        __delay_ms(100);
    }
}

int main(void)
{
    uint8_t message;
    uint8_t loraReady;

    SYSTEM_Initialize();

    /* RC1 is the TPL5110 DONE output. It must start low after every wake. */
    ANSELCbits.ANSC1 = 0;
    LATCbits.LATC1 = 0;
    TRISCbits.TRISC1 = 0;

    /* RC4 and RC5 are the buttons; RC4/RC5 have no ANSEL bit on this device. */
    IO_RC4_SetDigitalInput();
    IO_RC5_SetDigitalInput();

    /* RC3 and RC6 drive the LEDs, both off until the pins are configured. */
    IO_RC3_SetDigitalMode();
    IO_RC6_SetDigitalMode();
    IO_RC3_SetLow();
    IO_RC6_SetLow();
    IO_RC3_SetDigitalOutput();
    IO_RC6_SetDigitalOutput();

    /* LoRa NSS/CS on RB5: digital output, inactive high. */
    ANSELBbits.ANSB5 = 0;
    TRISBbits.TRISB5 = 0;
    LATBbits.LATB5 = 1;

    /*
     * The power indicator goes on here and stays on until the TPL5110 removes
     * the supply. It is the only thing that reports whether the board is
     * powered, so nothing below is allowed to touch RC3.
     */
    IO_RC3_SetHigh();

    loraReady = LoRa_Initialize();

    if (loraReady == 0U)
    {
        /*
         * Report the fault on RC6 once, then carry on: the power-cycle test
         * has to stay usable even when the radio is not detected.
         */
        LoRa_ShowVersionError();
    }

    while (1)
    {
        /*
         * Diagnostic: RC6 follows the raw button level. If RC6 stays dark
         * while a button is held, the press never reaches the firmware and
         * nothing further down can run.
         */
        IO_RC6_LAT = (Buttons_Read() != 0U);

        message = Buttons_ReadDebounced();

        if (message == 0U)
        {
            continue;
        }

        /*
         * Skipped when the radio was not detected. SPI1_ByteExchange waits on
         * SSP1IF forever if the MSSP is disabled, which would hang the press
         * before RC1 ever moves.
         */
        if (loraReady != 0U)
        {
            (void)LoRa_Send(message);
        }

        /*
         * The button press is what ends this wake cycle: RC1 goes low -> high,
         * the TPL5110 cuts the supply and RC3 goes dark. Execution does not
         * return from here.
         */
        TPL5110_RequestPowerOff();
    }
}
